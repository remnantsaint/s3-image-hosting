APP_NAME = S3 Image Hosting
APP_ENV = development
DEBUG = true

# MySQL数据库配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=image_hosting
MYSQL_USER=image_hosting
MYSQL_PASSWORD=replace_me
MYSQL_ROOT_PASSWORD=replace_me

# JWT身份认证配置
JWT_SECRET_KEY=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# S3兼容对象存储配置
S3_ENDPOINT_URL=http://127.0.0.1:3900
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GKreplace_with_random_access_key
S3_SECRET_ACCESS_KEY=replace_with_random_secret_key
S3_BUCKET=image-hosting
S3_FORCE_PATH_STYLE=true

# Garage服务器内部配置
GARAGE_RPC_SECRET=replace_with_64_character_hex_secret

# Redis配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_with_a_random_password