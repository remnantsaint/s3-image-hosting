# 应用基础配置
APP_NAME=S3 Image Hosting
APP_ENV=development
DEBUG=true

# 应用对外访问配置
# 部署到服务器时，把绑定地址改为0.0.0.0，
# 并把公开地址改为服务器公网IP和实际端口。
APP_BIND_HOST=127.0.0.1
APP_HOST_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# MySQL数据库配置
# MYSQL_HOST和MYSQL_PORT供本地运行的FastAPI使用；
# Docker中的FastAPI会通过Compose服务名mysql连接3306端口。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_BIND_HOST=127.0.0.1
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=image_hosting
MYSQL_USER=image_hosting
MYSQL_PASSWORD=replace_with_a_random_password
MYSQL_ROOT_PASSWORD=replace_with_another_random_password

# JWT身份认证配置
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# S3兼容对象存储配置
# S3_ENDPOINT_URL供本地运行的FastAPI访问Garage；
# Docker中的FastAPI会通过Compose服务名garage访问3900端口。
S3_ENDPOINT_URL=http://127.0.0.1:3900
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=GKreplace_with_random_access_key
S3_SECRET_ACCESS_KEY=replace_with_random_secret_key
S3_BUCKET=image-hosting
S3_FORCE_PATH_STYLE=true

# Garage宿主机端口与服务器内部配置
GARAGE_BIND_HOST=127.0.0.1
GARAGE_HOST_PORT=3900
GARAGE_RPC_SECRET=replace_with_64_character_hex_secret

# Redis配置
# REDIS_HOST和REDIS_PORT供本地运行的FastAPI使用；
# Docker中的FastAPI会通过Compose服务名redis连接6379端口。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_with_a_random_password


# ============================================================
# 部署到Linux云服务器时的修改清单
# ============================================================
# 1. 复制模板：
#    cp .env.example .env
#
# 2. 将运行环境改为生产环境：
#    APP_ENV=production
#    DEBUG=false
#
# 3. 假设图床使用18080端口、Garage使用13900端口：
#    APP_BIND_HOST=0.0.0.0
#    APP_HOST_PORT=18080
#    PUBLIC_BASE_URL=http://服务器公网IP:18080
#
#    GARAGE_BIND_HOST=0.0.0.0
#    GARAGE_HOST_PORT=13900
#    S3_PUBLIC_ENDPOINT_URL=http://服务器公网IP:13900
#
# 4. MySQL和Redis不要绑定公网地址。
#    如果服务器的3306或6379已被占用，可以改成未占用的本地端口：
#    MYSQL_BIND_HOST=127.0.0.1
#    MYSQL_HOST_PORT=13306
#    REDIS_BIND_HOST=127.0.0.1
#    REDIS_HOST_PORT=16379
#
# 5. 以下内部连接配置保持不变，Docker Compose会在容器中覆盖主机名：
#    MYSQL_PORT=3306
#    REDIS_PORT=6379
#    S3_ENDPOINT_URL=http://127.0.0.1:3900
#
# 6. 在Linux服务器执行以下命令，生成可以直接粘贴进.env的配置行：
#    echo "MYSQL_PASSWORD=$(openssl rand -hex 24)"
#    echo "MYSQL_ROOT_PASSWORD=$(openssl rand -hex 24)"
#    echo "JWT_SECRET_KEY=$(openssl rand -hex 32)"
#    echo "REDIS_PASSWORD=$(openssl rand -hex 24)"
#    echo "GARAGE_RPC_SECRET=$(openssl rand -hex 32)"
#    echo "S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12)"
#    echo "S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32)"
#
# 7. 密钥只在首次部署时生成一次，并妥善备份。
#    已经创建MySQL、Garage数据卷后，不要随意更换这些值。
#
# 8. 云安全组只开放应用端口和Garage公开端口，
#    例如18080和13900；不要向公网开放MySQL和Redis端口。


# ============================================================
# Linux服务器首次部署流程
# ============================================================
# 一、部署前准备
# 1. 确认服务器已经安装Docker Engine和Docker Compose插件：
#    docker --version
#    docker compose version
#
# 2. 检查准备使用的端口是否已经被其他项目占用：
#    sudo ss -lntp
#    docker ps
#
# 3. 在云平台安全组中开放应用端口和Garage公开端口。
#    如果只让一位测试者使用，建议只允许该测试者的公网IP访问。
#    不要向公网开放MySQL、Redis和Garage RPC端口。
#
# 二、下载项目和创建配置
# 1. 从GitHub下载项目：
#    git clone <你的GitHub仓库地址>
#    cd s3-image-hosting
#
# 2. 根据示例创建服务器自己的.env：
#    cp .env.example .env
#    chmod 600 .env
#
# 3. 按照上面的“部署到Linux云服务器时的修改清单”修改.env，
#    填写公网IP、端口以及新生成的密码和密钥。
#
# 4. 检查Compose变量替换结果。该命令不会启动容器：
#    docker compose config
#
# 三、首次启动
# 1. 先启动MySQL、Redis和Garage：
#    docker compose up -d mysql redis garage
#
# 2. 查看基础服务是否已经健康：
#    docker compose ps
#
# 3. 构建FastAPI后端镜像和包含Vue页面的Nginx镜像：
#    docker compose build backend nginx
#
# 4. 执行Alembic数据库迁移，创建users、images等业务表：
#    docker compose run --rm backend alembic upgrade head
#
# 5. 启动整套服务：
#    docker compose up -d
#
# 四、哪些资源会自动创建
# 1. MySQL容器首次使用空数据卷启动时，会根据以下变量自动创建：
#    MYSQL_DATABASE指定的数据库；
#    MYSQL_USER指定的普通用户；
#    以及该用户的数据库权限。
#    因此不需要手动执行CREATE DATABASE。
#
# 2. Alembic迁移会创建users、images、alembic_version等数据表，
#    因此不需要手动执行建表SQL。
#
# 3. Garage首次启动时会根据S3_BUCKET、S3_ACCESS_KEY_ID和
#    S3_SECRET_ACCESS_KEY创建默认Bucket和访问密钥。
#
# 4. Redis不需要创建数据库表，启动后即可用于接口限流。
#
# 5. Nginx镜像构建时会自动执行npm ci和npm run build，
#    因此服务器不需要单独安装Node.js，也不需要手动运行npm run dev。
#
# 五、部署后的检查
# 1. 查看所有容器状态：
#    docker compose ps
#
# 2. 查看最近100行日志：
#    docker compose logs --tail=100
#
# 3. 在服务器本机检查应用健康状态，端口按实际APP_HOST_PORT填写：
#    curl http://127.0.0.1:18080/api/health
#
# 4. 在测试者电脑浏览器访问：
#    http://服务器公网IP:18080/
#
# 5. 依次测试注册、登录、上传、图片预览、固定分享、取消分享和删除。
#    当前允许用户通过注册页面自行创建账号，不需要手动写入用户表。
#
# 6. 重启容器后再次检查数据是否仍然存在：
#    docker compose restart
#
# 六、后续更新代码
# 1. 拉取新代码：
#    git pull
#
# 2. 重新构建镜像：
#    docker compose build backend nginx
#
# 3. 执行可能新增的数据库迁移：
#    docker compose run --rm backend alembic upgrade head
#
# 4. 使用新镜像重新创建服务：
#    docker compose up -d
#
# 七、数据安全注意事项
# 1. MySQL、Garage和Redis使用Docker数据卷保存数据，
#    普通的docker compose down不会删除这些数据卷。
#
# 2. 不要在有数据后执行docker compose down -v，
#    -v会删除MySQL、Garage和Redis数据卷。
#
# 3. 不要提交.env，也不要把真实密码、JWT密钥或Garage密钥发到GitHub。
#
# 4. 定期备份MySQL数据和Garage数据卷；部署更新前也应先备份。
#
# 5. 确保服务器磁盘有足够空间，因为上传的图片最终保存在Garage数据卷中。
